{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    // Explicit, rather than relying on every `@types/*` package under node_modules being
    // auto-included: confirmed needed on `typescript` 7.0.2 — without it, `Bun`, `process` and
    // the rest of `@types/bun`'s globals read as undefined even though the package is installed.
    "types": ["bun"]
  },
  "include": ["src"]
}
