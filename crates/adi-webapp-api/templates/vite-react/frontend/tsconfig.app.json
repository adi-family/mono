{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // No `baseUrl` — `typescript` 7.0.2 removed it; a `paths` value is resolved against the
    // tsconfig file's own directory now, which is exactly what `baseUrl: "."` meant here.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
