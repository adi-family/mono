#!/usr/bin/env bash
#
# pre-commit — keep every crate's `structs.gen.md` honest.
#
# The pages are generated from the source, so they are only worth having if they are never stale.
# This regenerates them and stages the ones that moved, so the shape of a commit's data model
# lands in the same commit as the code that changed it.
#
# It is a no-op unless the commit touches Rust sources (or the generator itself), so a commit that
# only edits markdown or a shell script costs nothing.
#
# Install: `scripts/install-hooks.sh` (points core.hooksPath at .githooks).
# Skip once: `git commit --no-verify`.
#
# Caveat worth knowing: the generator reads the *working tree*, not the index. If you staged only
# part of a file (`git add -p`), the regenerated page describes the whole file, including what you
# held back. That is almost always what you want for a generated overview — but it is why the hook
# tells you which pages it staged.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Nothing Rust-shaped in this commit → nothing to regenerate.
if ! git diff --cached --name-only --diff-filter=ACMR \
    | grep -Eq '^crates/[^/]+/(src/.*\.rs|Cargo\.toml)$'; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found; cannot refresh structs.gen.md." >&2
    echo "            Install Rust, or commit with --no-verify." >&2
    exit 1
fi

# Build quietly the first time, then it is a freshness check and a few hundred lines of parsing.
if ! cargo run -q -p adi-structs >/dev/null; then
    echo "pre-commit: adi-structs failed; structs.gen.md not refreshed." >&2
    exit 1
fi

# Stage whatever moved. `--` guards against a path that looks like a revision.
changed="$(git diff --name-only -- 'crates/*/structs.gen.md')"
untracked="$(git ls-files --others --exclude-standard -- 'crates/*/structs.gen.md')"
staged="$(printf '%s\n%s\n' "$changed" "$untracked" | sed '/^$/d' | sort -u)"

if [ -n "$staged" ]; then
    # shellcheck disable=SC2086 # paths here are generated by us and contain no spaces.
    git add -- $staged
    echo "pre-commit: refreshed and staged"
    printf '  %s\n' $staged
fi

exit 0
