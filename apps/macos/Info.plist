<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ADI</string>
    <key>CFBundleDisplayName</key>
    <string>ADI</string>
    <key>CFBundleIdentifier</key>
    <string>family.adi.ADI</string>
    <key>CFBundleExecutable</key>
    <string>ADI</string>
    <key>CFBundleIconFile</key>
    <string>ADI</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>adi-family</string>
    <!-- Which install this bundle drives. Restamped per flavour by build.sh; Sources/Core.swift
         reads it back and pins every adi-mono it launches, so ADI Dev.app cannot reach into the
         real install's store, ports or launchd namespace. -->
    <key>ADIFlavor</key>
    <string>release</string>
    <!-- The zone this install serves, so the app can link to its own dashboard without
         shelling out to ask. Restamped per flavour by build.sh alongside ADIFlavor. -->
    <key>ADIDomain</key>
    <string>adi</string>
</dict>
</plist>
