<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ADI</string>
    <key>CFBundleDisplayName</key>
    <string>ADI</string>
    <key>CFBundleIdentifier</key>
    <string>family.adi.ADI</string>
    <key>CFBundleExecutable</key>
    <string>ADI</string>
    <key>CFBundleIconFile</key>
    <string>ADI</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>© With ADI, Inc.</string>
    <!-- Where the bundled faces live, relative to Contents/Resources: Geist and Geist Mono
         (design/DESIGN.md §4), copied there by build.sh from Resources/Fonts. -->
    <key>ATSApplicationFontsPath</key>
    <string>Fonts</string>
    <!-- Which install this bundle drives. Restamped per flavour by build.sh; Sources/Core.swift
         reads it back and pins every adi-mono it launches, so ADI Dev.app cannot reach into the
         real install's store, ports or launchd namespace. -->
    <key>ADIFlavor</key>
    <string>release</string>
    <!-- The zone this install serves, so the app can link to its own dashboard without
         shelling out to ask. Restamped per flavour by build.sh alongside ADIFlavor. -->
    <key>ADIDomain</key>
    <string>adi</string>
    <!-- The store directory under $HOME, so the panel window can find the front door's CA
         (~/<ADIDir>/mono/hive/tls/ca.pem) and trust it for this zone. Restamped per flavour. -->
    <key>ADIDir</key>
    <string>.adi</string>
    <!-- The panel window (Sources/PanelWindow.swift) loads `https://app.adi`, but a page in it
         still links to plain `http://` hosts in the zone — a dashboard's own URL, a service the
         hive lists — and App Transport Security refuses those unless told otherwise. The traffic
         never leaves the loopback interface. NSAllowsLocalNetworking covers the
         `127.0.0.1:<port>` a dashboard is reached on before it has a host; the exception domain
         covers the zone itself, and also relaxes ATS's checks on the front door's locally minted
         certificate. Restamped per flavour by build.sh, beside ADIDomain — a dev build browses
         `.adi-dev`, and an exception naming `adi` would leave its every page blocked. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>adi</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
    <!-- Where the "Open an Issue" button goes. NOT restamped per flavour: a dev build's bugs
         belong in the same tracker as a release build's. The canonical value is the workspace
         Cargo.toml's `repository` — change the two together. -->
    <key>ADIIssuesURL</key>
    <string>https://github.com/adi-family/mono/issues/new</string>
</dict>
</plist>
