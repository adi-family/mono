<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ADI</string>
    <key>CFBundleDisplayName</key>
    <string>ADI</string>
    <key>CFBundleIdentifier</key>
    <string>family.adi.ADI</string>
    <key>CFBundleExecutable</key>
    <string>ADI</string>
    <key>CFBundleIconFile</key>
    <string>ADI</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>adi-family</string>
    <!-- Where the bundled faces live, relative to Contents/Resources: Geist and Geist Mono
         (design/DESIGN.md §4), copied there by build.sh from Resources/Fonts. -->
    <key>ATSApplicationFontsPath</key>
    <string>Fonts</string>
    <!-- Which install this bundle drives. Restamped per flavour by build.sh; Sources/Core.swift
         reads it back and pins every adi-mono it launches, so ADI Dev.app cannot reach into the
         real install's store, ports or launchd namespace. -->
    <key>ADIFlavor</key>
    <string>release</string>
    <!-- The zone this install serves, so the app can link to its own dashboard without
         shelling out to ask. Restamped per flavour by build.sh alongside ADIFlavor. -->
    <key>ADIDomain</key>
    <string>adi</string>
    <!-- The panel window (Sources/PanelWindow.swift) loads `http://app.adi`, and App Transport
         Security refuses plain HTTP unless it is told otherwise. There is no HTTPS to move to:
         the front door serves a zone that resolves only on this Mac, for which no certificate
         authority issues anything, and the traffic never leaves the loopback interface.
         NSAllowsLocalNetworking covers the `127.0.0.1:<port>` a dashboard is reached on before it
         has a host; the exception domain covers the zone itself. Restamped per flavour by
         build.sh, beside ADIDomain — a dev build browses `.adi-dev`, and an exception naming
         `adi` would leave its every page blocked. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>adi</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>
            </dict>
        </dict>
    </dict>
    <!-- Where the "Open an Issue" button goes. NOT restamped per flavour: a dev build's bugs
         belong in the same tracker as a release build's. The canonical value is the workspace
         Cargo.toml's `repository` — change the two together. -->
    <key>ADIIssuesURL</key>
    <string>https://github.com/adi-family/mono/issues/new</string>
</dict>
</plist>
