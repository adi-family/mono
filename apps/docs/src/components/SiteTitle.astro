---
// ADI's mark + wordmark in the top bar — design/DESIGN.md §10: 18px mark, monochrome
// (currentColor, back two hexagons at 52%/74% opacity; the colored version is app-icon/landing
// only), next to the wordmark `adi` at 15px/600. SVG markup copied from
// design/reference/design-system.html's `#mark` section (self-contained, no external refs).
// Links to the docs home, not the marketing site — see Header.astro for the withadi.dev link.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<svg viewBox="0 0 200 200" width="18" height="18" aria-hidden="true">
		<defs>
			<mask id="adi-mark-mk0" maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
				<rect width="200" height="200" fill="#fff" />
				<path
					d="M127.71 65.00 L178.81 94.50 L178.81 153.50 L127.71 183.00 L76.62 153.50 L76.62 94.50 Z"
					fill="#000"
				/>
				<path
					d="M100.00 17.00 L151.10 46.50 L151.10 105.50 L100.00 135.00 L48.90 105.50 L48.90 46.50 Z"
					fill="#000"
				/>
			</mask>
			<mask id="adi-mark-mk1" maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="200">
				<rect width="200" height="200" fill="#fff" />
				<path
					d="M100.00 17.00 L151.10 46.50 L151.10 105.50 L100.00 135.00 L48.90 105.50 L48.90 46.50 Z"
					fill="#000"
				/>
			</mask>
		</defs>
		<path
			d="M72.29 68.00 L120.78 96.00 L120.78 152.00 L72.29 180.00 L23.79 152.00 L23.79 96.00 Z"
			fill="currentColor"
			fill-opacity="0.52"
			mask="url(#adi-mark-mk0)"
		/>
		<path
			d="M127.71 68.00 L176.21 96.00 L176.21 152.00 L127.71 180.00 L79.22 152.00 L79.22 96.00 Z"
			fill="currentColor"
			fill-opacity="0.74"
			mask="url(#adi-mark-mk1)"
		/>
		<path
			d="M100.00 20.00 L148.50 48.00 L148.50 104.00 L100.00 132.00 L51.50 104.00 L51.50 48.00 Z"
			fill="currentColor"
		/>
	</svg>
	<span translate="no">adi</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 10px;
			font-size: 15px;
			font-weight: 600;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
		svg {
			flex-shrink: 0;
		}
	}
</style>
