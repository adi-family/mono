---
// Vendored from `@astrojs/starlight`'s internal `TableOfContentsList.astro` (MIT licensed):
// that component isn't part of the package's overridable component set (only `TableOfContents`
// and `MobileTableOfContents` are — see `components` in `astro.config.mjs`), and it renders
// `heading.text` as an escaped string, so there's no prop-based way to have it render real icon
// markup ahead of a heading's title. This copy adds exactly that: each heading's flags, read from
// `virtual:doc-heading-flags`'s off-disk map (keyed on the current page's slug plus the heading's
// own title text, whitespace-collapsed the same way on both sides — see that module and
// `wiki-links.mjs`'s `buildHeadingFlagsMap`), rendered as Lucide icons ahead of the title text,
// in declaration order. See `heading-flags-plugin.mjs`.
import { FLAG_ICONS, type FlagKind } from './flag-icons';
// @ts-expect-error — virtual module, only known to Vite (see `heading-flags-plugin.mjs`)
import { headingFlags } from 'virtual:doc-heading-flags';

interface TocItem {
	depth: number;
	slug: string;
	text: string;
	children: TocItem[];
}

interface Props {
	toc: TocItem[];
	pageSlug: string;
	depth?: number;
	isMobile?: boolean;
}

const { toc, pageSlug, isMobile = false, depth = 0 } = Astro.props;
---

<ul class:list={{ isMobile }}>
	{
		toc.map((heading) => {
			const title = heading.text.replace(/\s+/g, ' ').trim();
			const flags: string[] = headingFlags.get(`${pageSlug}::${title}`) ?? [];
			return (
				<li>
					<a href={'#' + heading.slug}>
						{flags.map((kind) => {
							const Icon = FLAG_ICONS[kind as FlagKind];
							return (
								<span class="flag-icon" role="img" aria-label={kind} title={kind}>
									<Icon size={14} stroke-width={1.5} aria-hidden="true" />
								</span>
							);
						})}
						<span>{heading.text}</span>
					</a>
					{heading.children.length > 0 && (
						<Astro.self toc={heading.children} pageSlug={pageSlug} depth={depth + 1} isMobile={isMobile} />
					)}
				</li>
			);
		})
	}
</ul>

<style define:vars={{ depth }}>
	@layer starlight.core {
		ul {
			padding: 0;
			list-style: none;
		}
		a {
			--pad-inline: 0.5rem;
			display: flex;
			align-items: center;
			gap: 0.375rem;
			border-radius: 0.25rem;
			padding-block: 0.25rem;
			padding-inline: calc(1rem * var(--depth) + var(--pad-inline)) var(--pad-inline);
			line-height: 1.25;
		}
		a[aria-current='true'] {
			color: var(--sl-color-text-accent);
		}
		.isMobile a {
			--pad-inline: 1rem;
			justify-content: space-between;
			gap: var(--pad-inline);
			border-top: 1px solid var(--sl-color-gray-6);
			border-radius: 0;
			padding-block: 0.5rem;
			color: var(--sl-color-text);
			font-size: var(--sl-text-sm);
			text-decoration: none;
			outline-offset: var(--sl-outline-offset-inside);
		}
		.isMobile:first-child > li:first-child > a {
			border-top: 0;
		}
		.isMobile a[aria-current='true'],
		.isMobile a[aria-current='true']:hover,
		.isMobile a[aria-current='true']:focus {
			color: var(--sl-color-white);
			background-color: unset;
		}
		.isMobile a[aria-current='true']::after {
			content: '';
			width: 1rem;
			background-color: var(--sl-color-text-accent);
			/* Check mark SVG icon */
			-webkit-mask-image: url('data:image/svg+xml;base64,');
			mask-image: url('data:image/svg+xml;base64,');
			-webkit-mask-repeat: no-repeat;
			mask-repeat: no-repeat;
			flex-shrink: 0;
		}
		.flag-icon {
			display: inline-flex;
			flex-shrink: 0;
			color: var(--ink-2);
		}
	}
</style>
