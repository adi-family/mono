---
// design/DESIGN.md §6 Tag: sans, 12px, pill, `.07` tint fill, `--ink-2` text. Flags (Preview /
// Expert area / Enterprise interest) are categorical labels on a section, not a live state, so
// they reuse Tag's plain non-semantic look rather than inventing a colored dot.
//
// Authored as `<Flags>Preview</Flags>`, a slotted child — but inside a heading,
// `remark-flags.mjs` rewrites that slotted text into a `kind` attribute before this component
// ever renders, specifically so it *doesn't* ride along into Astro's heading-text/anchor-id
// extraction (which used to duplicate a flag's name into the heading's own title and slug — see
// that plugin's comment). The sidebar's flag icons come from a separate mechanism entirely
// (`src/components/toc/`, reading the flag names straight off the source file), so `kind` here
// only has to reproduce the in-body pill. The `<slot />` fallback keeps `<Flags>` usable as
// authored outside a heading, where no such rewrite happens.
interface Props {
	kind?: string;
}

const { kind } = Astro.props;
---

<span class="flag">{kind ?? <slot />}</span>

<style>
	.flag {
		display: inline-block;
		font-size: 12px;
		font-weight: 400;
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--chip);
		color: var(--ink-2);
		white-space: nowrap;
		vertical-align: middle;
	}
</style>
