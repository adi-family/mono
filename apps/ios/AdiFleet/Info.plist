<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>adi Fleet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both taken from the build settings rather than written out again. They used to be literals
	     here *and* in project.yml, which is two places holding one number: on 2026-08-31 an upload
	     was rejected as a duplicate of build 1, and bumping project.yml alone would have changed
	     nothing, because this file is what the built bundle actually carries. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- The faces the app is set in (design/DESIGN.md §4): Geist and Geist Mono, variable TTFs
	     under Fonts/, with their OFL beside them. xcodegen adds the folder's files as resources at
	     the bundle root, which is the path UIAppFonts expects. -->
	<key>UIAppFonts</key>
	<array>
		<string>Geist[wght].ttf</string>
		<string>GeistMono[wght].ttf</string>
	</array>
	<!-- How a Home Screen shortcut reaches one dashboard. iOS gives an app no way to place an icon
	     itself — only Safari and Shortcuts may — so the supported route is a Shortcut that opens a
	     URL, and this is the URL it opens: adifleet://open?node=<petname>&service=<label>.
	     A private scheme rather than a universal link on purpose: a universal link needs a domain
	     serving an apple-app-site-association file, and a viewer that reaches its machines by key
	     over the mesh should not need a website to open one of them. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>family.adi.fleet.link</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>adifleet</string>
			</array>
		</dict>
	</array>
	<!-- iPhone: no upside-down, which is the platform convention and what a phone held to read a
	     dashboard actually wants. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad: all four, and not by preference. The app ships for iPad too
	     (TARGETED_DEVICE_FAMILY "1,2"), and App Store Connect *rejects* an iPad build that omits
	     any of them unless it also declares UIRequiresFullScreen — a split-screen app cannot be
	     told which way the device is held. Validation caught this as error 90474; the same thing
	     shows up locally as the "All interface orientations must be supported" build warning. -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A node's services are reached through a loopback listener inside this app, so the web view
	     loads http://127.0.0.1:<port>. The transport is not plaintext on the wire — it is QUIC with
	     TLS 1.3 between authenticated keys; the only plaintext hop is inside this process, between
	     WKWebView and the app's own socket. This key permits exactly that hop and nothing else. -->
	<!-- Export compliance, answered here instead of by hand on every upload. The app's only
	     cryptography is TLS 1.3 inside QUIC (iroh/rustls) and Ed25519 peer identities — standard
	     algorithms used for authentication and a secure channel, which is the exemption in
	     Category 5 Part 2 that this key declares. It implements no cryptography of its own.
	     Revisit it if that ever stops being true; it is a legal declaration, not a build flag. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iroh looks at local interfaces to find a direct path to a peer before falling back to a
	     relay. On a shared network that path is the fast one, and iOS asks before allowing it. -->
	<!-- Pairing. A token is over nine hundred characters, so the machine draws it as a QR and this
	     phone reads it — the same call the web client made and wrote down: scanning is the primary
	     action and the paste field is the fallback. The camera is used for nothing else, and the
	     session is torn down the moment the scanner closes (`ScanView`). -->
	<key>NSCameraUsageDescription</key>
	<string>adi Fleet uses the camera only to scan the pairing code a machine shows, so you don't have to type a 900-character invite.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>adi Fleet looks for your machines on this network so it can reach them directly instead of through a relay.</string>
</dict>
</plist>
