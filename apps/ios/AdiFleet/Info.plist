<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>adi Fleet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>UILaunchScreen</key>
	<dict/>
	<!-- How a Home Screen shortcut reaches one dashboard. iOS gives an app no way to place an icon
	     itself — only Safari and Shortcuts may — so the supported route is a Shortcut that opens a
	     URL, and this is the URL it opens: adifleet://open?node=<petname>&service=<label>.
	     A private scheme rather than a universal link on purpose: a universal link needs a domain
	     serving an apple-app-site-association file, and a viewer that reaches its machines by key
	     over the mesh should not need a website to open one of them. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>family.adi.fleet.link</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>adifleet</string>
			</array>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- A node's services are reached through a loopback listener inside this app, so the web view
	     loads http://127.0.0.1:<port>. The transport is not plaintext on the wire — it is QUIC with
	     TLS 1.3 between authenticated keys; the only plaintext hop is inside this process, between
	     WKWebView and the app's own socket. This key permits exactly that hop and nothing else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iroh looks at local interfaces to find a direct path to a peer before falling back to a
	     relay. On a shared network that path is the fast one, and iOS asks before allowing it. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>adi Fleet looks for your machines on this network so it can reach them directly instead of through a relay.</string>
</dict>
</plist>
