# Build artifacts
/target
**/*.rs.bk

# macOS app build output (assembled .app bundle + packaged .dmg)
apps/*/build/
# Xcode's own derived data — build.sh points -derivedDataPath at these, and they hold a few
# hundred MB of precompiled modules and build logs that rebuild from source in one command.
apps/*/.build/
apps/*/.build-device/
# Xcode per-user state inside a generated project
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# The code index a project carries: SQLite plus a usearch vector index, rebuilt from source by
# `adi-mono indexer index` and tens of megabytes on a tree this size.
.adi/

# The isolated store the dev loop runs adi-app against (scripts/dev.sh, and the supervised
# `adi` project services), plus the log a panel-started runner drops in its working dir.
/.adi-dev/
server.log

# Backtraces
rustc-ice-*.txt

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
